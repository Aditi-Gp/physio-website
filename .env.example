# ==============================================================================
# Dr. Anchal Gupta Physiotherapy - Environment Variables Template
# Copy this file to .env for local development (never commit .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Form BaaS Providers (Static Forms / FormBold)
# Choose either FormBold or Static Forms for serverless booking submissions
# ------------------------------------------------------------------------------
# Option A: FormBold (https://formbold.com) - Supports file uploads seamlessly
FORMBOLD_FORM_ID=your_formbold_form_id_here
FORMBOLD_ENDPOINT=https://formbold.com/s/your_formbold_form_id_here

# Option B: Static Forms (https://www.staticforms.xyz)
STATIC_FORMS_ACCESS_KEY=your_static_forms_access_key_here
STATIC_FORMS_ENDPOINT=https://api.staticforms.xyz/submit

# Active Form Provider selection: 'formbold' or 'staticforms'
FORM_PROVIDER=formbold

# ------------------------------------------------------------------------------
# 2. International payment credentials (PayPal checkout is not yet implemented)
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ------------------------------------------------------------------------------
# 3. Direct Contact & Notification
# ------------------------------------------------------------------------------
WHATSAPP_NUMBER=917042123365
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_DOCTOR_TEMPLATE_ID=
EMAILJS_PATIENT_TEMPLATE_ID=
DOCTOR_EMAIL=

# ------------------------------------------------------------------------------
# 4. Google Reviews (server-only)
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ------------------------------------------------------------------------------
# 5. Render backend (server-only)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=10000
ALLOWED_ORIGINS=http://localhost:3000

# Razorpay: use test keys locally and in staging; keep live keys in Render only.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_test_webhook_secret

# ------------------------------------------------------------------------------
# 6. MongoDB Atlas
# Keep the URI free of credentials; username and password are provided separately.
# ------------------------------------------------------------------------------
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://cluster-host/physiotherapy?retryWrites=true&w=majority

# Vercel build-time public configuration. Do not set these to secrets.
PUBLIC_API_BASE_URL=https://your-render-service.onrender.com
