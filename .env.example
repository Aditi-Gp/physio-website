# ==============================================================================
# Dr. Anchal Gupta Physiotherapy - Environment Variables Template
# Copy this file to .env.local for local development (never commit .env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Form BaaS Providers (Static Forms / FormBold)
# Choose either FormBold or Static Forms for serverless booking submissions
# ------------------------------------------------------------------------------
# Option A: FormBold (https://formbold.com) - Supports file uploads seamlessly
FORMBOLD_FORM_ID=your_formbold_form_id_here
FORMBOLD_ENDPOINT=https://formbold.com/s/your_formbold_form_id_here

# Option B: Static Forms (https://www.staticforms.xyz)
STATIC_FORMS_ACCESS_KEY=your_static_forms_access_key_here
STATIC_FORMS_ENDPOINT=https://api.staticforms.xyz/submit

# Active Form Provider selection: 'formbold' or 'staticforms'
FORM_PROVIDER=formbold

# ------------------------------------------------------------------------------
# 2. Payment Gateways
# ------------------------------------------------------------------------------
# Razorpay (Domestic Payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# PayPal (International Payments)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ------------------------------------------------------------------------------
# 3. Direct Contact & Notification
# ------------------------------------------------------------------------------
WHATSAPP_NUMBER=917042123365

# ------------------------------------------------------------------------------
# 4. Optional Custom Backend (Vercel Serverless / Google Sheets)
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
